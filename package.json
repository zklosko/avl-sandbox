{
  "name": "avl-sandbox",
  "version": "0.0.1",
  "description": "A framework for creating mock networked A/V devices",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test",
    "check": "tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zklosko/avl-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/zklosko/avl-sandbox/issues"
  },
  "keywords": [
    "av",
    "audio",
    "video",
    "udp",
    "tcp",
    "mock",
    "testing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
